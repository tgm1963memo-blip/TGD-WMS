# TGD WMS nightly backup settings -- copied to C:\TGD-Backups\config\backup.env
# Never commit the filled-in file. Anyone who can read it can access the whole database.

# Supabase Dashboard -> Project Settings -> Database -> Connection string ->
# "Session pooler" (URI). Paste it exactly as shown (the host below is only an
# example) and replace [YOUR-PASSWORD] with the database password.
SUPABASE_DB_URL=postgresql://postgres.lievvsqbosvrolkrftna:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Same values as VITE_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in .env.local
SUPABASE_URL=https://lievvsqbosvrolkrftna.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: also copy each backup here (NAS share or external drive), e.g. \\nas\backup\tgd-wms
EXTRA_COPY_DIR=

# Optional: off-machine copy. Each night the whole backup is packed into ONE
# AES-256 encrypted .7z (file names encrypted too) and copied here, e.g. a
# OneDrive folder. Only the encrypted archive ever goes to this folder.
ONEDRIVE_COPY_DIR=
# Required when ONEDRIVE_COPY_DIR is set: at least 16 characters, no quotes.
# Write it down somewhere safe -- without it the OneDrive copies cannot be opened.
ARCHIVE_PASSWORD=
# Only if 7-Zip is not in C:/Program Files/7-Zip/7z.exe
SEVEN_ZIP_PATH=
